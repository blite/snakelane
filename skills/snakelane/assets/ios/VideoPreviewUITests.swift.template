// iOS only: the recorder is `simctl io recordVideo`, which has no Mac equivalent.
#if os(iOS)

    import XCTest

    /// The App Preview's player, for `previews.test`. Prefer `previews.launch` with
    /// `PreviewMarks.swift.template`: an attached UI test costs the app frames, and the
    /// clip stutters (worst on iPad). Use this only when the app can't mark its own moments.
    ///
    /// `snakelane preview` records the simulator (and taps the app's sound) while this
    /// test parks the app in a state that plays itself. It talks to snakelane through two
    /// files on the Mac's disk, which the simulator shares:
    ///
    ///   /tmp/{{APP_SLUG}}-preview-events.jsonl   this test appends {"event", "t"} lines
    ///   /tmp/{{APP_SLUG}}-preview-rolling        snakelane writes it once the recorder runs
    ///
    /// Events: "ready" when the scene is up (snakelane then starts recording), "start" and
    /// "end" around the clip, and any other name as a moment an overlay caption can be timed to.
    /// The clip is what lies between "start" and "end": keep it 15–30 s.
    final class {{UI_TEST_TARGET_NAME}}VideoPreviewUITests: XCTestCase {

        override func setUpWithError() throws {
            continueAfterFailure = false
        }

        @MainActor
        func test01AutoPlayDemo() throws {
            let app = XCUIApplication()
            // TODO (snakelane scaffold): a `video-demo` scenario in `UITestScreenshotScenario`
            // that resumes the app into a state that plays itself forward (a game with every
            // seat driven by AI, a slideshow that advances). Nothing here should drive the UI.
            // Not a bare "UITests": on the Mac AppKit opens a dash-less argument as a file.
            app.launchArguments += ["--ui-tests", "--ui-screenshot=video-demo"]
            app.launch()

            // TODO: an element that exists once the auto-playing scene is on screen.
            XCTAssertTrue(app.otherElements["someIdentifier"].waitForExistence(timeout: 15),
                          "Video-demo scene never rendered")

            Preview.mark("ready")
            XCTAssertTrue(Preview.waitUntilRolling(timeout: 30), "snakelane never started recording")
            Preview.mark("start")
            // TODO: let the app play. While recording, don't query the app (no
            // waitForExistence, no element lookups): each query snapshots its
            // accessibility tree on the main thread and the clip hitches. Let the app
            // mark its own moments in the events file and wait on those instead:
            // XCTAssertTrue(Preview.waitFor("won", timeout: 90))
            sleep(24)
            Preview.mark("end")
        }
    }

    /// The handshake with `snakelane preview`. Without it running (a test run from Xcode), the
    /// marks go nowhere and the wait gives up after its timeout.
    enum Preview {
        static let events = URL(fileURLWithPath: "/tmp/{{APP_SLUG}}-preview-events.jsonl")
        static let rolling = URL(fileURLWithPath: "/tmp/{{APP_SLUG}}-preview-rolling")

        static func mark(_ event: String) {
            let line = Data("{\"event\": \"\(event)\", \"t\": \(Date().timeIntervalSince1970)}\n".utf8)
            if let handle = try? FileHandle(forWritingTo: events) {
                handle.seekToEndOfFile()
                handle.write(line)
                try? handle.close()
            } else {
                try? line.write(to: events)
            }
        }

        /// An event the app (or this test) appended, without touching the app.
        static func waitFor(_ event: String, timeout: TimeInterval) -> Bool {
            let deadline = Date().addingTimeInterval(timeout)
            while Date() < deadline {
                if let text = try? String(contentsOf: events, encoding: .utf8),
                    text.contains("\"event\": \"\(event)\"")
                {
                    return true
                }
                Thread.sleep(forTimeInterval: 0.1)
            }
            return false
        }

        static func waitUntilRolling(timeout: TimeInterval) -> Bool {
            let deadline = Date().addingTimeInterval(timeout)
            while Date() < deadline {
                if FileManager.default.fileExists(atPath: rolling.path) { return true }
                Thread.sleep(forTimeInterval: 0.05)
            }
            return false
        }
    }

#endif
