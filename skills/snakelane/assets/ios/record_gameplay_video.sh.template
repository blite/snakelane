#!/usr/bin/env bash
#
# Record an App Preview-style gameplay video.
#
# The UI test runs serially (`-parallel-testing-enabled NO`) on the named simulator itself, so
# that is the device to record. With parallel testing on, xcodebuild would run it on a cold
# clone instead: a UDID nobody knows in advance, in a CoreSimulator set a bare `simctl` can't
# see, whose boot races SpringBoard. The script:
#
#   1. Resolves and boots the named simulator.
#   2. Runs `build-for-testing` first, so the slow compile isn't inside the recording wait.
#   3. Launches `test-without-building` in the background, serially, on that simulator.
#   4. Waits for the test to write a "scene-ready" marker into its Documents directory before
#      starting `simctl io recordVideo`. That handshake keeps SpringBoard and app-launch
#      frames out of the clip.
#   5. Stops the recorder with SIGINT (which finalizes the .mov) as soon as the test writes a
#      "done" marker or exits.
#
# Output lands at build/previews/<device-slug>.mov, a gitignored build artifact.
#
# Usage:
#   scripts/record_gameplay_video.sh [device]
#
# `device` defaults to "iPhone 17 Pro Max". Pass the full simctl device name for a different
# target (e.g. "iPad Pro 13-inch (M5)").

set -euo pipefail

DEVICE_NAME="${1:-iPhone 17 Pro Max}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUTPUT_ROOT="$REPO_ROOT/build/previews"
DEVICE_SLUG="$(echo "$DEVICE_NAME" | tr ' /()' '----' | tr -s '-')"
OUTPUT_PATH="$OUTPUT_ROOT/$DEVICE_SLUG.mov"

# XCTest UI test bundle ID used for `simctl get_app_container`. Xcode appends ".xctrunner"
# when it builds the runner app. Update this if your UI test target's
# PRODUCT_BUNDLE_IDENTIFIER is not `{{UI_TEST_BUNDLE_IDENTIFIER}}`.
TEST_RUNNER_BUNDLE_ID="{{UI_TEST_BUNDLE_IDENTIFIER}}.xctrunner"

# Handshake markers the UI test writes to its Documents directory.
READY_MARKER_NAME="hh-video-ready.marker"
DONE_MARKER_NAME="hh-video-done.marker"

mkdir -p "$OUTPUT_ROOT"
rm -f "$OUTPUT_PATH"

# The newest available iOS runtime's simulator with this exact name.
UDID="$(
    xcrun simctl list devices available --json | python3 -c "
import json, re, sys
found = [(tuple(map(int, re.findall(r'\d+', runtime))), d['udid'])
         for runtime, devices in json.load(sys.stdin)['devices'].items()
         if 'iOS' in runtime for d in devices if d['name'] == sys.argv[1]]
print(max(found)[1] if found else '')
" "$DEVICE_NAME"
)"
if [[ -z "$UDID" ]]; then
    echo "error: no available simulator named '$DEVICE_NAME' (xcrun simctl list devices available)" >&2
    exit 1
fi
DESTINATION="platform=iOS Simulator,id=$UDID"

echo "→ Target device: $DEVICE_NAME ($UDID)"
echo "→ Output: $OUTPUT_PATH"
xcrun simctl boot "$UDID" 2>/dev/null || true   # already booted is fine
xcrun simctl bootstatus "$UDID" -b >/dev/null

echo "→ Building test bundles (build-for-testing)..."
xcodebuild \
    -project "$REPO_ROOT/{{PROJECT_NAME}}.xcodeproj" \
    -scheme "{{SCHEME_NAME}}" \
    -destination "$DESTINATION" \
    -only-testing "{{UI_TEST_TARGET_NAME}}/{{UI_TEST_TARGET_NAME}}VideoPreviewUITests" \
    build-for-testing \
    -quiet

TEST_LOG="$(mktemp -t video-test-XXXXX).log"
echo "→ Launching test-without-building (log: $TEST_LOG)..."
xcodebuild \
    -project "$REPO_ROOT/{{PROJECT_NAME}}.xcodeproj" \
    -scheme "{{SCHEME_NAME}}" \
    -destination "$DESTINATION" \
    -parallel-testing-enabled NO \
    -only-testing "{{UI_TEST_TARGET_NAME}}/{{UI_TEST_TARGET_NAME}}VideoPreviewUITests/test01AutoPlayDemo" \
    test-without-building >"$TEST_LOG" 2>&1 &
TEST_PID=$!

cleanup() {
    local rc=$?
    kill -INT "${RECORDER_PID:-0}" 2>/dev/null || true
    wait "${RECORDER_PID:-0}" 2>/dev/null || true
    if kill -0 "$TEST_PID" 2>/dev/null; then
        kill "$TEST_PID" 2>/dev/null || true
        wait "$TEST_PID" 2>/dev/null || true
    fi
    return $rc
}
trap cleanup EXIT

echo "→ Waiting for scene-ready marker from the test..."
TEST_CONTAINER=""
for _ in $(seq 1 240); do
    TEST_CONTAINER="$(xcrun simctl get_app_container "$UDID" "$TEST_RUNNER_BUNDLE_ID" data 2>/dev/null || true)"
    if [[ -n "$TEST_CONTAINER" ]] && [[ -f "$TEST_CONTAINER/Documents/$READY_MARKER_NAME" ]]; then
        break
    fi
    if ! kill -0 "$TEST_PID" 2>/dev/null; then
        echo "error: test exited before writing the ready marker — see $TEST_LOG" >&2
        exit 1
    fi
    sleep 0.5
done

if [[ -z "$TEST_CONTAINER" ]] || [[ ! -f "$TEST_CONTAINER/Documents/$READY_MARKER_NAME" ]]; then
    echo "error: never saw ready marker at $TEST_CONTAINER/Documents/$READY_MARKER_NAME — see $TEST_LOG" >&2
    exit 1
fi

echo "→ Scene up. Starting recording..."
xcrun simctl io "$UDID" recordVideo --codec=h264 "$OUTPUT_PATH" &
RECORDER_PID=$!

echo "→ Waiting for test to finish (or done marker)..."
while kill -0 "$TEST_PID" 2>/dev/null; do
    if [[ -f "$TEST_CONTAINER/Documents/$DONE_MARKER_NAME" ]]; then
        break
    fi
    sleep 0.25
done

kill -INT "$RECORDER_PID" 2>/dev/null || true
wait "$RECORDER_PID" 2>/dev/null || true

if ! wait "$TEST_PID"; then
    echo "error: xcodebuild test failed — see $TEST_LOG" >&2
    exit 1
fi

trap - EXIT

SIZE_BYTES=$(stat -f%z "$OUTPUT_PATH" 2>/dev/null || echo 0)
if (( SIZE_BYTES < 100000 )); then
    echo "error: recorded file is only ${SIZE_BYTES} bytes — check $TEST_LOG for clues" >&2
    exit 1
fi

ls -la "$OUTPUT_PATH"
echo "✓ Video ready at: $OUTPUT_PATH"
